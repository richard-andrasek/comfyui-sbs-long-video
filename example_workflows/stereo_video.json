{"id":"311f0d67-1217-422e-94c4-5035de24c7e5","revision":0,"last_node_id":5,"last_link_id":2,"nodes":[{"id":2,"type":"StereoVideoConvert","pos":[-382.7969386506145,-330.8939241943518],"size":[187.41666412353516,46],"flags":{},"order":2,"mode":0,"inputs":[{"localized_name":"video_job","name":"video_job","type":"STEREO_VIDEO_JOB","link":2}],"outputs":[{"localized_name":"rendered_video","name":"rendered_video","type":"STEREO_VIDEO_RENDER","links":[1]},{"localized_name":"summary","name":"summary","type":"STRING","links":null}],"properties":{"Node name for S&R":"StereoVideoConvert"},"widgets_values":[]},{"id":1,"type":"StereoVideoMuxOutput","pos":[-82.35684801682014,-330.8372332439608],"size":[270,102],"flags":{},"order":3,"mode":0,"inputs":[{"localized_name":"rendered_video","name":"rendered_video","type":"STEREO_VIDEO_RENDER","link":1},{"localized_name":"filename_prefix","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null},{"localized_name":"output_format","name":"output_format","type":"COMBO","widget":{"name":"output_format"},"link":null}],"outputs":[{"localized_name":"output_path","name":"output_path","type":"STRING","links":null},{"localized_name":"depth_output_path","name":"depth_output_path","type":"STRING","links":null}],"properties":{"Node name for S&R":"StereoVideoMuxOutput"},"widgets_values":["SBS-Long-Video-scm-","mkv"]},{"id":3,"type":"StereoVideoSource","pos":[-867.6780191779012,-340.1222009514045],"size":[402.3863636363636,486],"flags":{},"order":0,"mode":0,"inputs":[{"localized_name":"source_video","name":"source_video","type":"COMBO","widget":{"name":"source_video"},"link":null},{"localized_name":"stereo_layout","name":"stereo_layout","type":"COMBO","widget":{"name":"stereo_layout"},"link":null},{"localized_name":"output_depth_video","name":"output_depth_video","type":"BOOLEAN","widget":{"name":"output_depth_video"},"link":null},{"localized_name":"depth_model","name":"depth_model","type":"COMBO","widget":{"name":"depth_model"},"link":null},{"localized_name":"depth_use_source_resolution","name":"depth_use_source_resolution","type":"BOOLEAN","widget":{"name":"depth_use_source_resolution"},"link":null},{"localized_name":"depth_inference_resolution","name":"depth_inference_resolution","type":"INT","widget":{"name":"depth_inference_resolution"},"link":null},{"localized_name":"preview_run","name":"preview_run","type":"BOOLEAN","widget":{"name":"preview_run"},"link":null},{"localized_name":"chunk_size","name":"chunk_size","type":"INT","widget":{"name":"chunk_size"},"link":null},{"localized_name":"disparity_percent","name":"disparity_percent","type":"FLOAT","widget":{"name":"disparity_percent"},"link":null},{"localized_name":"depth_power","name":"depth_power","type":"FLOAT","widget":{"name":"depth_power"},"link":null},{"localized_name":"invert_depth","name":"invert_depth","type":"BOOLEAN","widget":{"name":"invert_depth"},"link":null},{"localized_name":"audio_mode","name":"audio_mode","type":"COMBO","widget":{"name":"audio_mode"},"link":null},{"localized_name":"depth_normalization_method","name":"depth_normalization_method","type":"COMBO","widget":{"name":"depth_normalization_method"},"link":null},{"localized_name":"global_depth_max","name":"global_depth_max","type":"FLOAT","widget":{"name":"global_depth_max"},"link":null},{"localized_name":"depth_edge_refine_method","name":"depth_edge_refine_method","type":"COMBO","widget":{"name":"depth_edge_refine_method"},"link":null}],"outputs":[{"localized_name":"video_job","name":"video_job","type":"STEREO_VIDEO_JOB","links":[2]},{"localized_name":"summary","name":"summary","type":"STRING","links":null}],"properties":{"Node name for S&R":"StereoVideoSource"},"widgets_values":["Schmigadoon..S01E01.1080p.WEB.H264-EXPLOIT.mkv","sbs",false,"da3_large",true,1024,false,12,1.15,0.35,1.15,"copy","global",750,"fgs","upload"]},{"id":5,"type":"MarkdownNote","pos":[-1406.302143213137,-388.91075364589096],"size":[480,550],"flags":{},"order":1,"mode":0,"inputs":[],"outputs":[],"title":"Model Links","properties":{},"widgets_values":["[Tutorial](https://github.com/richard-andrasek/comfyui-sbs-long-video/blob/main/TUTORIAL.md\n)\n\n## Limited Hardware\n\nThe original base project was built for this scenario. I would start with these settings\n\n* depth_model:  da3_large  (\"large\" is still pretty small.  Try medium if you must.)\n* depth_use_source_resolution: true (but false for highly limited systems)\n* depth_inference_resolution: 1024 (only matters if \"source resolution\" is false, 512 may improve performance with lower quality)\n* chunk_size:  4 (Lower this if you max out your vram. Raise this if you have more vram)\n* depth_edge_refine_method: none (simple is a little slower, fgs is higher quality and a lot slower)\n\n## Higher Quality\n\nThis what I use with my RTX 5060ti (16GB vram)\n\n* depth_model:  da3_large\n* depth_use_source_resolution: true\n* depth_inference_resolution: 1024 (only matters if \"source resolution\" is false)\n* chunk_size:  12\n* depth_edge_refine_method: fgs (fgs is much slower but much reduced artifacts)\n\n## Common settings\n\nThese settings are for the 3d rendering, so they are common across all hardware:\n\n* disparity_percent:  1.15 (this can be used if the video becomes uncomfortable to watch)\n* depth_power:  0.30  (0.35 if you use `fgs`.  Increase if the video feels flat. Decrease if it's strangely \"too 3d\")\n* invert_depth:  true\n* audio_mode:  copy\n* depth_normalization_method: global (\"simple\" may be ok for single-shot videos - no processing advantage either way)\n* global_depth_max: 750 (watch the console for warnings. If the video feels flat, lower this until you get a lot of warnings and then raise it to stop the warnings)\n\n\n\n"],"color":"#432","bgcolor":"#000"}],"links":[[1,2,0,1,0,"STEREO_VIDEO_RENDER"],[2,3,0,2,0,"STEREO_VIDEO_JOB"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.7513148009015777,"offset":[1677.8281432131366,849.8201999268829]},"workflowRendererVersion":"LG"},"version":0.4}