normalization_method","type":"COMBO","widget":{"name":"depth_normalization_method"},"link":null},{"localized_name":"global_depth_max","name":"global_depth_max","type":"FLOAT","widget":{"name":"global_depth_max"},"link":null},{"localized_name":"depth_edge_refine_method","name":"depth_edge_refine_method","type":"COMBO","widget":{"name":"depth_edge_refine_method"},"link":null},{"localized_name":"zero_parallax","name":"zero_parallax","type":"COMBO","widget":{"name":"zero_parallax"},"link":null},{"localized_name":"constant_zero_parallax","name":"constant_zero_parallax","type":"FLOAT","widget":{"name":"constant_zero_parallax"},"link":null},{"localized_name":"particle_effects_config","name":"particle_effects_config","shape":7,"type":"particle_effects_config","link":null}],"outputs":[{"localized_name":"video_job","name":"video_job","type":"STEREO_VIDEO_JOB","links":[5]},{"localized_name":"summary","name":"summary","type":"STRING","links":null}],"properties":{"Node name for S&R":"StereoVideoSource"},"widgets_values":["TestClip5-LWW.mkv","sbs",false,false,"da3_large",512,true,512,12,0.65,0.6,"copy",0.7,"copy","adaptive global",900,"fgs","subject",0,"upload"]}],"links":[[1,2,0,1,0,"STEREO_VIDEO_RENDER"],[5,8,0,2,0,"STEREO_VIDEO_JOB"],[6,10,0,2,1,"SBS_FACE_DETECTOR"]],"groups":[],"config":{},"extra":{"ds":{"scale":1.4641000000000006,"offset":[1081.1448759977798,435.91479655279556]},"workflowRendererVersion":"LG"},"version":0.4}